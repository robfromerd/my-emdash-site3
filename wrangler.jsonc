{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-emdash-site3",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-emdash-site3",
      "database_id": "b66c26c2-19c1-49b0-b59b-001a936b6d00"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "my-emdash-media3",
      "preview_bucket_name": "my-emdash-media3"
    }
  ],
"kv_namespaces": [{
                    "binding": "KV_BINDING",
                    "id": "56c64999d5674de3a5c7e72106d28073"
                 }],
  "observability": {
    "enabled": true
  }
}
